<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scanlio</name>
  <version>0.9.0</version>
  <description>2D laser-inertial odometry, teaching project built step by step alongside NdtLIO</description>
  <maintainer email="zodiac@todo.todo">zodiac</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>origincar_msg</depend>
  <!-- yaml-cpp：CMakeLists 中 find_package(yaml-cpp REQUIRED)，
       不声明时 rosdep 不会安装，板载重新 colcon build 会在 cmake 配置阶段失败 -->
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
